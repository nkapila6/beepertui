# shared look for every clip
Set Shell "bash"
Set FontFamily "IosevkaFixedSS15 Nerd Font"
Set FontSize 16
Set Width 1440
Set Height 900
Set Padding 18
Set Theme "rose-pine-moon"
Set TypingSpeed 70ms
Set WindowBar Colorful
Set BorderRadius 10
Set Margin 24
Set MarginFill "#191724"

Env BEEPER_URL "http://127.0.0.1:23999"
Env BEEPER_ACCESS_TOKEN "demo"
Env BEEPERTUI_NERDFONT "1"
Env BEEPERTUI_MOUSE "off"

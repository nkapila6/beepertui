Output ../assets/demo/switch.gif
Output ../assets/demo/switch.mp4
Source tapes/settings.tape

Hide
Type "clear && beepertui" Enter
Sleep 1.5s
Enter
Sleep 1.2s
Show

Sleep 1s
# cc: every chat, fuzzy filtered
Type "cc"
Sleep 1.2s
Type "hke"
Sleep 1s
Enter
Sleep 1.8s
# J / K step through chats
Type "J"
Sleep 1.2s
Type "J"
Sleep 1.2s
Type "K"
Sleep 1s
# c labels just the chats
Type "c"
Sleep 1.6s
Type "f"
Sleep 1.6s
# C opens a chat's action menu
Type "CC"
Sleep 1.8s
Type "p"
Sleep 1.5s

Output ../assets/demo/compose.gif
Output ../assets/demo/compose.mp4
Source tapes/settings.tape

Hide
Type "clear && beepertui" Enter
Sleep 1.5s
Type "J"
Sleep 1.2s
Show

Sleep 1s
# mentions, and multi-line (shift+enter, or ctrl+j anywhere)
Type "i"
Sleep 400ms
Type "morning @om"
Sleep 1.2s
Tab
Sleep 400ms
Type "still on for 7?"
Ctrl+J
Type "I'll bring coffee"
Sleep 1.2s
Enter
Sleep 1.4s
Escape
Sleep 500ms
# link hints: f, pick a label, then o opens or y yanks
Type "K"
Sleep 1.5s
Type "f"
Sleep 1.6s
Type "a"
Sleep 1.4s
Type "y"
Sleep 1.2s
# image viewer
Type "k"
Sleep 300ms
Type "k"
Sleep 400ms
Enter
Sleep 3s
Escape
Sleep 1s

Output ../assets/demo/flash.gif
Output ../assets/demo/flash.mp4
Source tapes/settings.tape

Hide
Type "clear && beepertui" Enter
Sleep 1.5s
Enter
Sleep 1.5s
Show

Sleep 1s
# r labels every message, a is the newest one
Type "r"
Sleep 1.6s
Type "a"
Sleep 500ms
Type "on it, looks great"
Sleep 400ms
Enter
Sleep 1.2s
Escape
Sleep 600ms
# react to an older message by its label, searching the emoji by name
Type "R"
Sleep 1.4s
Type "d"
Sleep 800ms
Type "fire"
Sleep 1s
Enter
Sleep 1.2s
# yy yanks the cursor message, s jumps anywhere
Type "yy"
Sleep 1s
Type "s"
Sleep 1.8s
Escape
Sleep 1s
